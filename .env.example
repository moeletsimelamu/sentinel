# Copy to .env for local overrides. .env is git-ignored — never commit real secrets.
# Every value below is for LOCAL DEVELOPMENT ONLY.

SENTINEL_ENV=development
SENTINEL_LOG_LEVEL=INFO
SENTINEL_LOG_JSON=true

# Postgres (docker compose). The API/worker connection URL is built from this in compose.
POSTGRES_PASSWORD=sentinel
SENTINEL_DB_PORT=5438
SENTINEL_API_PORT=8088

# Used when running the backend on the host (outside Docker):
SENTINEL_DATABASE_URL=postgresql+psycopg://sentinel:sentinel@localhost:5438/sentinel

# Generate real values with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to start with SENTINEL_ENV=production unless both are set to strong values.
SENTINEL_JWT_SECRET=dev-only-insecure-secret-change-me-0000000000
SENTINEL_HASH_SALT=dev-only-salt

# Browsers treat http://localhost as secure, so Secure cookies work in local dev.
SENTINEL_COOKIE_SECURE=true
SENTINEL_CORS_ORIGINS=["http://localhost:5173"]

# Password for the demo accounts created by `python -m sentinel.cli seed-demo-users`.
# Demo/test value only — never reuse a real password here.
SENTINEL_DEMO_PASSWORD=Sentinel-Demo-2026!
